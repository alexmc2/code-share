# Environment variables for CodeShare
# Copy to .env and modify as needed

# Signalling server URL
# In production, this should be your deployed server URL (e.g., https://your-domain.com)
VITE_SIGNALLING_URL=http://localhost:3001

# STUN servers (comma-separated)
# Google's public STUN servers work for most cases
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server for NAT traversal when direct P2P fails
# You'll need to configure your own TURN server (coturn, Twilio, etc.)
# Leave empty if no TURN server is available
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
